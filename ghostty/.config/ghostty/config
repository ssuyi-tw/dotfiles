# Font
font-family = Hack Nerd Font
font-size = 14

# Window
window-padding-x = 16
window-padding-y = 8
window-padding-balance = true
mouse-hide-while-typing = false

# macOS — play nice with yabai + JankyBorders
macos-titlebar-style = hidden
macos-window-shadow = false
macos-titlebar-proxy-icon = hidden

# Scrollback (bytes, ~10MB)
scrollback-limit = 10485760

shell-integration = none

# Gruvbox dark, hard
background = 1c1c1c
foreground = ebdbb2
cursor-color = fbf1c7
cursor-text = 32302f
cursor-style = block
cursor-style-blink = false
selection-foreground = 928374
selection-background = 3c3836

palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
